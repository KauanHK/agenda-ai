# Grupos de configuração aninhados: o prefixo antes de `__` é o grupo.

# ── AgendaBot (AGENDABOT__) ──────────────────────────────────────────────────
AGENDABOT__API_URL=https://agenda.escaleia.cloud
AGENDABOT__MCP_URL=https://agenda.escaleia.cloud/mcp
AGENDABOT__SERVICE_KEY=
AGENDABOT__ESTABLISHMENT_ID=01a04f5b-0e84-7530-be67-63f08e7b2269
AGENDABOT__ESTABLISHMENT_TIMEZONE=America/Sao_Paulo

# ── Telegram (TELEGRAM__) ────────────────────────────────────────────────────
TELEGRAM__BOT_TOKEN=
TELEGRAM__WEBHOOK_SECRET=
# Bearer token das rotas administrativas (`/admin/telegram/webhook`), que
# registram e consultam o webhook. Gere com `openssl rand -hex 32`.
TELEGRAM__ADMIN_TOKEN=
# Opcional: raiz da Bot API. Troque só para apontar a um Local Bot API Server
# ou a um endpoint de teste. Padrão: https://api.telegram.org
# TELEGRAM__API_ROOT=https://api.telegram.org

# ── LLM (LLM__) ──────────────────────────────────────────────────────────────
LLM__PROVIDER=anthropic
LLM__MODEL=claude-sonnet-5
LLM__TEMPERATURE=0.3
LLM__MAX_TOKENS=1024
# Exigida conforme o LLM__PROVIDER escolhido (uma das duas).
LLM__ANTHROPIC_API_KEY=
LLM__OPENAI_API_KEY=

# ── Redis (REDIS__) ──────────────────────────────────────────────────────────
# No docker-compose o host é o serviço `redis`: REDIS__URL=redis://redis:6379/1
REDIS__URL=redis://localhost:6379/1

# ── Conversa e limites do agente (CONVERSATION__) ────────────────────────────
CONVERSATION__TTL_MINUTES=1440
CONVERSATION__MAX_HISTORY_MESSAGES=10
CONVERSATION__MAX_AGENT_STEPS=8
CONVERSATION__MAX_INPUT_CHARS=1000
CONVERSATION__SESSION_REFRESH_MARGIN_SECONDS=60

# ── Identidade / fase 1 (IDENTITY__) ─────────────────────────────────────────
IDENTITY__SYNTHETIC_PHONE_PREFIX=5547999

# ── HTTP / MCP (HTTP__) ──────────────────────────────────────────────────────
# TIMEOUT_SECONDS: read/write/pool da API do AgendaBot (emissão da sessão).
HTTP__TIMEOUT_SECONDS=10.0
# CONNECT_TIMEOUT_SECONDS: abrir a conexão TCP+TLS, comum a AgendaBot e Telegram.
HTTP__CONNECT_TIMEOUT_SECONDS=5.0
# TELEGRAM_READ_TIMEOUT_SECONDS: read/write/pool da Bot API (curto: responde rápido).
HTTP__TELEGRAM_READ_TIMEOUT_SECONDS=5.0
HTTP__MCP_TIMEOUT_SECONDS=15.0

# ── Observabilidade (OBSERVABILITY__) ────────────────────────────────────────
OBSERVABILITY__LOG_LEVEL=INFO

# ── docker-compose ──────────────────────────────────────────────────────────
# Imagem puxada pelo `docker-compose.yml` de produção (owner/repo em minúsculas).
# Nos runners do GitHub Actions a variável já vem preenchida por `github.repository`.
GITHUB_REPOSITORY=kauanhk/agenda-ai-agent
