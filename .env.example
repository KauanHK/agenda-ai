# ── AgendaBot ────────────────────────────────────────────────────────────────
AGENDABOT_API_URL=https://agenda.escaleia.cloud
AGENDABOT_MCP_URL=https://agenda.escaleia.cloud/mcp
AGENDABOT_SERVICE_KEY=
ESTABLISHMENT_ID=01a04f5b-0e84-7530-be67-63f08e7b2269
ESTABLISHMENT_TIMEZONE=America/Sao_Paulo

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Exigida conforme o LLM_PROVIDER escolhido (uma das duas).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Conversa e limites do agente ─────────────────────────────────────────────
CONVERSATION_TTL_MINUTES=1440
MAX_HISTORY_MESSAGES=40
MAX_AGENT_STEPS=8
MAX_INPUT_CHARS=1000
SESSION_REFRESH_MARGIN_SECONDS=60

# ── Identidade (fase 1) ──────────────────────────────────────────────────────
SYNTHETIC_PHONE_PREFIX=5547999

# ── HTTP / MCP ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=10.0
MCP_TIMEOUT_SECONDS=15.0

# ── Observabilidade ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
