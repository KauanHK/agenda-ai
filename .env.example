# Copie para .env e preencha. Existe um único .env, na raiz do projeto.
#
# Consumidores:
#   backend (app/core/settings.py) ... lê este arquivo via pydantic-settings
#   frontend (vite, `npm run dev`) ... lê VITE_* daqui (envDir aponta p/ a raiz)
#   docker-compose.yml (VPS) ......... env_file: ./.env
#   docker-compose.local.yml (dev) ... env_file: ./.env; as variáveis de
#                                      Postgres/Redis são sobrescritas pelo
#                                      compose (host = db / redis).
#
# Na VPS o arquivo fica em /opt/agenda-bot/.env

# ── Frontend ───────────────────────────────────────────────────────────────
# Só usado no `npm run dev`. No build Docker o valor vem de um ARG (=/api).
VITE_API_URL=http://localhost:8745

# ── Postgres ────────────────────────────────────────────────────────────────
# Em vez das 5 variáveis abaixo você pode definir só DATABASE_URL
# (ex.: postgresql+asyncpg://user:pass@host:5432/db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-me

# ── JWT / tokens ────────────────────────────────────────────────────────────
JWT_SECRET=troque-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MIN=30
REFRESH_TOKEN_EXPIRES_DAYS=7
MCP_SESSION_TOKEN_EXPIRES_MINUTES=10

# ── Google Calendar ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8745/auth/google/callback
FRONTEND_URL=http://localhost:8080
GOOGLE_OAUTH_FRONTEND_PATH=/integrations/google

# ── Redis ──────────────────────────────────────────────────────────────────
# broker/backend do Celery
REDIS_URL=redis://:troque-me@redis:6379/0
REDIS_PASSWORD=troque-me

# ── WhatsApp (Evolution API) ───────────────────────────────────────────────
EVOLUTION_URL=https://evolution.example.com
EVOLUTION_INSTANCE=Evolution
EVOLUTION_APIKEY=

# ── Agente / MCP ───────────────────────────────────────────────────────────
# Assina o token de sessão do cliente usado pelo servidor MCP. Separado do
# JWT_SECRET de propósito: escopos diferentes, comprometimentos independentes.
# openssl rand -hex 32
AGENT_SESSION_SECRET=troque-me

# ── Canais (bots do Telegram por estabelecimento) ─────────────────────────
# Cifra o token do bot e o segredo do webhook guardados no banco. A API não
# sobe sem uma chave Fernet válida. O valor abaixo é só de exemplo; gere a sua:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: perder a chave obriga a reconectar todos os bots (os tokens ficam
# ilegíveis). Guarde um backup fora da VPS.
CHANNEL_SECRETS_KEY=ZXhlbXBsby1uYW8tdXNlLWVtLXByb2R1Y2FvLTEyMzQ=
# Base HTTPS pública onde o nginx expõe /webhook/. Conectar um bot registra o
# webhook em {base}/webhook/telegram/{establishment_id}. Em produção é o domínio
# do SaaS; em dev, a URL do túnel (o Telegram só aceita HTTPS).
TELEGRAM_WEBHOOK_BASE_URL=https://seu-tunel.example.com

# ── Agente de IA (app.main_agent) ─────────────────────────────────────────
# Todas as variáveis do agente começam com AGENT_ e são lidas por
# app/modules/agent/settings.py. Grupos aninhados: o prefixo antes de `__` é o
# grupo (AGENT_LLM__MODEL → llm.model).
#
# ── AgendaBot (AGENT_AGENDABOT__) ────────────────────────────────────────
# O MCP é chamado pela rede interna do compose, sem passar pelo domínio público.
AGENT_AGENDABOT__MCP_URL=http://mcp:8001/mcp
AGENT_AGENDABOT__ESTABLISHMENT_ID=01a04f5b-0e84-7530-be67-63f08e7b2269
AGENT_AGENDABOT__ESTABLISHMENT_TIMEZONE=America/Sao_Paulo

# ── Telegram (AGENT_TELEGRAM__) ──────────────────────────────────────────
AGENT_TELEGRAM__BOT_TOKEN=
AGENT_TELEGRAM__WEBHOOK_SECRET=
# Bearer token das rotas administrativas (`/admin/telegram/webhook`), que
# registram e consultam o webhook. Gere com `openssl rand -hex 32`.
AGENT_TELEGRAM__ADMIN_TOKEN=
# Opcional: raiz da Bot API. Troque só para apontar a um Local Bot API Server
# ou a um endpoint de teste. Padrão: https://api.telegram.org
# AGENT_TELEGRAM__API_ROOT=https://api.telegram.org

# ── LLM (AGENT_LLM__) ────────────────────────────────────────────────────
AGENT_LLM__PROVIDER=anthropic
AGENT_LLM__MODEL=claude-sonnet-5
AGENT_LLM__TEMPERATURE=0.3
AGENT_LLM__MAX_TOKENS=1024
# Exigida conforme o AGENT_LLM__PROVIDER escolhido (uma das três).
# groq: tier gratuito em https://console.groq.com; use AGENT_LLM__MODEL=llama-3.3-70b-versatile.
AGENT_LLM__ANTHROPIC_API_KEY=
AGENT_LLM__OPENAI_API_KEY=
AGENT_LLM__GROQ_API_KEY=

# ── Redis (AGENT_REDIS__) ────────────────────────────────────────────────
# Redis 8 próprio do agente (serviço `agent-redis`), não o Redis do Celery.
# O checkpointer (RediSearch) só cria índices no db 0 — não use outro banco.
AGENT_REDIS__URL=redis://agent-redis:6379/0

# ── Conversa e limites do agente (AGENT_CONVERSATION__) ──────────────────
AGENT_CONVERSATION__TTL_MINUTES=1440
AGENT_CONVERSATION__MAX_HISTORY_TURNS=10
AGENT_CONVERSATION__MAX_AGENT_STEPS=8
AGENT_CONVERSATION__MAX_INPUT_CHARS=1000
AGENT_CONVERSATION__SESSION_REFRESH_MARGIN_SECONDS=60

# ── Identidade / fase 1 (AGENT_IDENTITY__) ───────────────────────────────
AGENT_IDENTITY__SYNTHETIC_PHONE_PREFIX=5547999

# ── HTTP / MCP (AGENT_HTTP__) ────────────────────────────────────────────
# CONNECT_TIMEOUT_SECONDS: abrir a conexão TCP+TLS com o Telegram.
AGENT_HTTP__CONNECT_TIMEOUT_SECONDS=5.0
# TELEGRAM_READ_TIMEOUT_SECONDS: read/write/pool da Bot API (curto: responde rápido).
AGENT_HTTP__TELEGRAM_READ_TIMEOUT_SECONDS=5.0
AGENT_HTTP__MCP_TIMEOUT_SECONDS=15.0

# ── Observabilidade (AGENT_OBSERVABILITY__) ──────────────────────────────
AGENT_OBSERVABILITY__LOG_LEVEL=INFO
